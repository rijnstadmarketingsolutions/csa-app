{
  // Vantis: één Worker voor de app (statische bestanden), de API en de 24/7 scanner
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vantis",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "csa-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
  "vars": {
    "PREMIUM_ENFORCED": "false",
    "VAPID_SUBJECT": "mailto:info@rijnstadmarketing.nl",
    "DISCORD_APP_ID": "1573694064694526023",
    "DISCORD_PUBLIC_KEY": "1801f95279c829bcb00c6f4e7ed6fb3f379faffc0d7b60e3e7372051d6b6fdb9",
    "DISCORD_GUILD_ID": "1573692320757321861"
  }
}
