{
  // Vantis: één Worker voor de app (statische bestanden), de API en de 24/7 scanner
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vantis",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "csa-db", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["*/5 * * * *", "0 7 * * *", "17 3 * * *", "0 17 * * SUN"] },
  "observability": { "enabled": true },
  "vars": {
    "PREMIUM_ENFORCED": "false",
    "VAPID_SUBJECT": "mailto:info@rijnstadmarketing.nl"
  }
}
